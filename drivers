
CREATE TABLE drivers_final AS
SELECT
    -- formatting id as TEXT
    TRIM(id) AS driver_id,

    -- standardize country (uppercase + normalize common cases) some countries have abbreviations
    CASE 
        WHEN UPPER(TRIM(country)) IN ('FR', 'FRANCE') THEN 'FRANCE'
        WHEN UPPER(TRIM(country)) IN ('AT', 'AUSTRIA', 'ÖSTERREICH') THEN 'AUSTRIA'
        ELSE UPPER(TRIM(country))
    END AS country,

    -- fixing the rating (removing hidden characters and spaces if available)
    CAST(
        ROUND(TRIM(REPLACE(REPLACE(rating, '﻿', ''), ' ', '')), 2)
        AS REAL
    ) AS rating,

    -- converting rating_count into integer
    CAST(rating_count AS INTEGER) AS rating_count,

    -- fixing the mixed date formats
    CASE 
        WHEN date_registration GLOB '[0-9]*' AND LENGTH(date_registration) <= 10
        THEN DATETIME(CAST(date_registration AS INTEGER), 'unixepoch')

        ELSE DATETIME(date_registration)
    END AS registration_date,

    -- converting boolean text into integer for easier main table integration
    CASE 
        WHEN LOWER(TRIM(receive_marketing)) IN ('true', '1') THEN 1
        WHEN LOWER(TRIM(receive_marketing)) IN ('false', '0') THEN 0
        ELSE NULL
    END AS receive_marketing

FROM freenow_drivers;
